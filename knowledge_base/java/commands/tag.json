{
  "name": "tag",
  "syntax": "/tag <targets> add|remove|list [<name>]",
  "description": "管理实体的标签，用于标记和分组实体",
  "category": "entity_management",
  "parameters": [
    {
      "name": "targets",
      "type": "target",
      "required": true,
      "description": "要操作标签的目标实体"
    },
    {
      "name": "add <name>",
      "type": "子命令",
      "required": false,
      "description": "为目标添加指定标签"
    },
    {
      "name": "remove <name>",
      "type": "子命令",
      "required": false,
      "description": "移除目标的指定标签"
    },
    {
      "name": "list",
      "type": "子命令",
      "required": false,
      "description": "列出目标拥有的所有标签"
    }
  ],
  "examples": [
    {
      "input": "/tag @s add admin",
      "description": "给自己添加admin标签"
    },
    {
      "input": "/tag @e[type=minecraft:zombie] add boss",
      "description": "给所有僵尸添加boss标签"
    },
    {
      "input": "/tag @s remove admin",
      "description": "移除自己的admin标签"
    },
    {
      "input": "/tag @s list",
      "description": "列出自己拥有的所有标签"
    },
    {
      "input": "/kill @e[tag=temp]",
      "description": "（配合使用）杀死所有带有temp标签的实体"
    }
  ],
  "java_specific_notes": "标签在Java版和基岩版中用法基本一致。选择器中使用tag=xxx或tag=!xxx进行过滤。Java版中标签也可以通过NBT的Tags列表在summon时直接设置。每个实体可拥有多个标签，标签名区分大小写。",
  "version_added": "1.13"
}